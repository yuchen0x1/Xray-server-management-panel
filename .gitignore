# Ignore editor and IDE settings
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.cursor/
.specify/
.claude/
.cache/
.mimosa/
.sync*

# Ignore log files
*.log

# Ignore temporary files
tmp/
*.tar.gz
*.zip
*.7z
*.bak
*.old
*.tmp
.localrun/

# Ignore build and distribution directories
backup/
bin/
x-ui/
dist/
!internal/web/dist/
internal/web/dist/*
!internal/web/dist/.gitkeep
release/
node_modules/
coverage/
storybook-static/
test-results/
playwright-report/
.next/
.source/
*.tsbuildinfo

# Ignore compiled binaries
main

# Ignore OS specific files
.DS_Store
Thumbs.db

# Ignore Go build files
*.exe
x-ui.db
x-ui.db-shm
x-ui.db-wal
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
system_metrics.gob
*.dump

# Ignore Docker specific files
docker-compose.override.yml

# Ignore .env (Environment Variables) file
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.pfx
*.msi

# Ignore AI agent working notes and one-off audit drafts; these are local
# scratch output, not project documentation, and must not be published.
.autonomous-upgrade/
PROJECT_AUDIT_REPORT.md
UPGRADE_PLAN.md
